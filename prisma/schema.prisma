generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  clerkId   String   @unique
  email     String   @unique
  name      String?
  role      String   @default("user") // user | manager | admin
  createdAt DateTime @default(now())

  pos    POS[]
  orders Order[]
  tickets SupportTicket[]
  notifications Notification[]
  cashierRequests CashierRequest[]
}

model POS {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  name      String
  data      Json
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  orders Order[]
  cashiers Cashier[]
  cashierRequests CashierRequest[]
}

enum OrderStatus {
  pending
  paid
  failed
}

model Order {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  userId         String      @db.ObjectId
  posId          String      @db.ObjectId
  cashierId      String?     @db.ObjectId
  items          Json
  total          Float
  discount       Json?
  paymentDetails Json?
  status         OrderStatus @default(pending)
  idempotencyKey String? @unique
  receiptNumber String @unique
  createdAt      DateTime    @default(now())
  
  user User @relation(fields: [userId], references: [id])
  pos  POS  @relation(fields: [posId], references: [id])
  cashier Cashier? @relation(fields: [cashierId], references: [id])
}

model Cashier {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  posId String @db.ObjectId
  pos POS @relation(fields: [posId], references: [id])

  username     String @unique
  passwordHash String

  fullName String?

  openingCash Float
  shiftStart String?
  shiftEnd String?

  isActive Boolean @default(true)
  allowedIp String?
  sessions CashierSession[]
  orders Order[]

  createdAt DateTime @default(now())
}


model CashierSession {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  cashierId String @db.ObjectId

  token String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())

  cashier Cashier @relation(fields: [cashierId],references: [id])
}

enum CashierRequestStatus {
  pending
  approved
  rejected
}

model CashierRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  ownerId String @db.ObjectId
  posId   String @db.ObjectId

  requestedCashiers Int
  cashierConfigs Json

  status CashierRequestStatus @default(pending)

  createdAt DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])
  pos   POS  @relation(fields: [posId], references: [id])
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId

  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])

  title     String
  message   String

  ticketId  String?  @db.ObjectId
  isRead    Boolean @default(false)

  createdAt DateTime @default(now())
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model SupportTicket {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId

  userId       String   @db.ObjectId
  user         User     @relation(fields: [userId], references: [id])

  title        String
  message      String

  department   String?
  urgency      Boolean?
  frustration  Int?
  meta         Json?

  status       SupportTicketStatus   @default(OPEN)
  resolution   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}